# Generated as config/secrets.env with mode 0600 when local credentials are absent.
# Fill the two values and restart. This file is ignored by Git.
BKMQB_QQ_OFFICIAL_APP_ID=
BKMQB_QQ_OFFICIAL_APP_SECRET=
BKMQB_ONEBOT_ACCESS_TOKEN=
# Enable [management] in bot.toml and set an independent random management token (32..=256 visible ASCII characters).
# Generate one with: openssl rand -hex 32
# BKMQB_MANAGEMENT_TOKEN=
# Optional named Bearer credential requested by external plugins and explicitly granted by an administrator.
# BKMQB_PLUGIN_HTTP_BEARER_GITHUB_ISSUE=github_pat_replace_me
