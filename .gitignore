# Ignore everything at the repository root by default.
/*

# Repository metadata and source.
!/.github/
!/.gitignore
!/Cargo.lock
!/Cargo.toml
!/LICENSE-MIT
!/LICENSE-APACHE
!/build.rs
!/rustfmt.toml
!/config/
!/crates/
!/plugins/
!/src/
!/test-data/
!/test-support/
!/webui/
/webui/node_modules/
/webui/*.tsbuildinfo

# Build artifacts.
/target/
/test-support/wasm-plugins/*/target/

# Editor and operating-system files.
.idea/
.vscode/
*.swp
*.swo
.DS_Store
__pycache__/

# Local configuration and secrets.
.env
.env.*
!.env.example
config.local.toml
/config/bot.toml
/config/plugins.toml
/config/plugins.qq-smoke.toml
/config/secrets.env
secrets.toml
*.pem
*.key

# Runtime state.
/data/
/logs/
*.db
*.db-shm
*.db-wal
